# Copier en .env et renseigner. Chaque variable est décrite dans
# docs/installation.md, section « Les variables d'environnement ».

# `npm run hash-password` produit la ligne
ADMIN_PASSWORD_HASH=
# `openssl rand -base64 48` en fournit une
SESSION_SECRET=

ACYCLIQ_API_URL=
ACYCLIQ_TOKEN=
LIZMAP_BASE_URL=

DATABASE_URL=postgres://smmarchives:smmarchives@localhost:5432/smmarchives
# Pour `npm test` seulement
DATABASE_URL_TEST=postgres://smmarchives:smmarchives@localhost:5432/smmarchives

# Pour le service `db` de Docker Compose seulement, appliqués à la création de son volume
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=5432

MEDIA_PATH=data/media
API_PORT=3000
TRUST_PROXY=loopback
# Le serveur de développement de l'interface
WEB_PORT=5180

# Vide, les rejeux se construisent sans lames d'eau
RADAR_RAINFALL_PATH=
# « minLon,minLat,maxLon,maxLat » en EPSG:4326 ; vide, l'emprise par défaut
RADAR_RAINFALL_BBOX=

# Pour Docker Compose seulement
HTTP_PORT=8080
RADAR_HOST_PATH=
