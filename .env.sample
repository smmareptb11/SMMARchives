# Copier en .env et renseigner. Aucun secret n'est versionné.

# --- Aquasys ----------------------------------------------------------------
# L'URL de base de l'API se renseigne auprès de l'exploitant du service.
# Le jeton est un secret : ni versionné, ni journalisé, ni placé dans une URL.
# Le renouvellement se fait par configuration, et non en attendant qu'une
# rotation prenne effet côté serveur.
ACYCLIQ_API_URL=
ACYCLIQ_TOKEN=

# Référence de temps sous laquelle les bornes de requête sont interprétées.
# Le fuseau de stockage de la source n'est pas établi : ne pas figer
# d'hypothèse. Doit être un fuseau IANA, sans quoi le démarrage échoue.
AQUASYS_TIME_ZONE=UTC

# --- Lizmap du SMMAR --------------------------------------------------------
# Outil de gestion de crise en production : requêtes espacées, lecture seule,
# et jamais en volume. L'URL de base se renseigne auprès de l'exploitant.
LIZMAP_BASE_URL=

# --- Base de données --------------------------------------------------------
# PostgreSQL avec PostGIS. `docker compose up -d db` en fournit une en
# développement. Le schéma s'applique par `npm run migrate`.

# Identifiants du conteneur de développement. PostgreSQL ne les applique qu'à
# la création du volume : les changer ensuite n'a aucun effet tant que le
# volume `db` existe. Laissés vides, ils valent `smmarchives` tous les trois.
DB_USER=
DB_PASSWORD=
DB_NAME=

# Port publié par le conteneur, à changer si une autre base occupe déjà 5432
# sur la machine.
DB_PORT=5432

# La chaîne que l'application lit. Rien ne la déduit des quatre variables
# ci-dessus : c'est à cette ligne de s'accorder avec elles.
DATABASE_URL=postgres://smmarchives:smmarchives@localhost:5432/smmarchives

# La base contre laquelle tournent les tests de stockage et de routes.
# `npm test` refuse de démarrer sans elle ; chaque suite y migre un schéma
# qui lui est propre, donc la même base que le développement convient — et le
# port se règle avec `DB_PORT`, comme celui de `DATABASE_URL`.
DATABASE_URL_TEST=postgres://smmarchives:smmarchives@localhost:5432/smmarchives

# Volume des médias gelés, un répertoire par rejeu. La base et ce volume se
# sauvegardent ensemble : restaurés séparément, ils rendent des rejeux dont les
# images manquent. La valeur ci-dessous est un repli de développement — un
# chemin dans le dépôt, que git ignore, et que l'application crée à la demande.
# En production, c'est un volume persistant, et il se renseigne.
MEDIA_PATH=data/media

# --- API -------------------------------------------------------------------
# Port d'écoute. Aucune route n'est protégée tant que l'administration n'existe
# pas : ne pas exposer publiquement. Voir docs/api.md
API_PORT=3000

# --- Interface --------------------------------------------------------------
# Port du serveur de développement. Il lit `API_PORT` ci-dessus pour savoir où
# renvoyer `/replays` et `/health`, et refuse de démarrer si le port est pris
# plutôt que d'en prendre un autre en silence.
WEB_PORT=5180

# --- Lames d'eau radar ------------------------------------------------------
# Répertoire des livraisons Predict, indexé sur place. Il n'existe qu'après
# livraison, et la laisser vide n'est pas une erreur : un rejeu se construit
# alors sans la voie des lames d'eau, et sa trace le dit. Ce qui la demande par
# son nom — `index:radar-rainfall`, ou `build:replay --only radar-rainfall` —
# la refuse au contraire en nommant cette variable. Une racine renseignée mais
# illisible ne passe jamais en silence : le script s'arrête, et la voie d'une
# construction échoue.
RADAR_RAINFALL_PATH=

# Emprise commune à toutes les images, en EPSG:4326, « minLon,minLat,maxLon,maxLat ».
# Aucun world file ne l'établit et elle n'est pas confirmée : une emprise fausse
# décale toute la lame d'eau sans que rien ne le signale. Laissée vide, l'emprise
# par défaut du code s'applique.
RADAR_RAINFALL_BBOX=
